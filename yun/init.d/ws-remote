#!/bin/sh /etc/rc.common
# Remote workstation power control over ntfy.sh. Cron re-runs `start`
# every 10 min, which is a no-op while it is alive.

START=99
STOP=10

PIDFILE=/var/run/ws-remote.pid
SCRIPT=/root/ws-remote.py

start() {
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /usr/bin/python -- "$SCRIPT"
}

stop() {
	start-stop-daemon -K -q -p "$PIDFILE"
	rm -f "$PIDFILE"
}
